@startuml
top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam defaultTextAlignment center
hide circle

entity "Klient" as Klient {
  * id_klienta : int <<PK>>
  --
  nazwa : varchar
  osoba_kontaktowa : varchar
  email : varchar
  telefon : varchar
  status_klienta : varchar
}

entity "Rekruter" as Rekruter {
  * id_rekrutera : int <<PK>>
  --
  imie : varchar
  nazwisko : varchar
  email : varchar
  telefon : varchar
}

entity "Kandydat" as Kandydat {
  * id_kandydata : int <<PK>>
  --
  imie : varchar
  nazwisko : varchar
  email : varchar
  telefon : varchar
  lokalizacja : varchar
  doswiadczenie_zawodowe : text
  umiejetnosci : text
  wyksztalcenie : text
}

entity "Oferta" as Oferta {
  * id_oferty : int <<PK>>
  --
  id_klienta : int <<FK>>
  id_rekrutera : int <<FK>>
  tytul_stanowiska : varchar
  opis_stanowiska : text
  wymagania : text
  obowiazki : text
  lokalizacja : varchar
  tryb_pracy : varchar
  forma_zatrudnienia : varchar
  widelki_wynagrodzenia : varchar
  status_oferty : varchar
  data_utworzenia : date
  termin_waznosci : date
}

entity "Kryteria selekcji" as Kryteria {
  * id_oferty : int <<PK, FK>>
  --
  wymagane_umiejetnosci : text
  wymagane_doswiadczenie : text
  wymagane_wyksztalcenie : text
  jezyki_obce : text
  dostepnosc : varchar
  oczekiwania_finansowe : varchar
}

entity "CV" as CV {
  * id_cv : int <<PK>>
  --
  id_kandydata : int <<FK>>
  plik_cv : varchar
  nazwa_pliku : varchar
  format_pliku : varchar
  data_przeslania : date
  tresc_cv : text
  doswiadczenie : text
  umiejetnosci : text
  wyksztalcenie : text
}

entity "Aplikacja" as Aplikacja {
  * id_aplikacji : int <<PK>>
  --
  id_kandydata : int <<FK>>
  id_oferty : int <<FK>>
  id_cv : int <<FK>>
  data_zgloszenia : datetime
  status_aplikacji : varchar
  wynik_wstepnej_oceny : decimal
  komentarz_rekrutera : text
  list_motywacyjny : text
}

entity "Wynik analizy" as WynikAnalizy {
  * id_analizy : int <<PK>>
  --
  id_aplikacji : int <<FK>>
  wynik_punktowy : decimal
  poziom_dopasowania : varchar
  spelnione_kryteria : text
  niespelnione_kryteria : text
  rekomendacja : varchar
  uzasadnienie : text
  data_analizy : datetime
}

entity "Ranking" as Ranking {
  * id_rankingu : int <<PK>>
  --
  id_oferty : int <<FK>>
  data_utworzenia : datetime
  status_rankingu : varchar
}

entity "Pozycja rankingu" as PozycjaRankingu {
  * id_pozycji_rankingu : int <<PK>>
  --
  id_rankingu : int <<FK>>
  id_analizy : int <<FK>>
  numer_pozycji : int
  wynik_punktowy : decimal
  poziom_dopasowania : varchar
  komentarz : text
}

entity "Lista kandydatów" as ListaKandydatow {
  * id_listy : int <<PK>>
  --
  id_oferty : int <<FK>>
  id_klienta : int <<FK>>
  id_rekrutera : int <<FK>>
  data_utworzenia : datetime
  status_listy : varchar
}

entity "Kandydat na liście" as KandydatNaLiscie {
  * id_pozycji_listy : int <<PK>>
  --
  id_listy : int <<FK>>
  id_aplikacji : int <<FK>>
  stanowisko : varchar
  wynik_dopasowania : decimal
  notatka_rekrutera : text
}

entity "Decyzja klienta" as DecyzjaKlienta {
  * id_decyzji : int <<PK>>
  --
  id_pozycji_listy : int <<FK>>
  id_klienta : int <<FK>>
  decyzja : varchar
  uzasadnienie : text
  data_decyzji : datetime
  osoba_decyzyjna : varchar
}

entity "Opinia klienta" as OpiniaKlienta {
  * id_opinii : int <<PK>>
  --
  id_pozycji_listy : int <<FK>>
  id_klienta : int <<FK>>
  ocena_kandydata : varchar
  komentarz_klienta : text
  mocne_strony : text
  slabe_strony : text
  rekomendacja_klienta : varchar
  data_opinii : datetime
}

entity "Rozmowa" as Rozmowa {
  * id_rozmowy : int <<PK>>
  --
  id_pozycji_listy : int <<FK>>
  id_kandydata : int <<FK>>
  id_klienta : int <<FK>>
  id_rekrutera : int <<FK>>
  id_oferty : int <<FK>>
  forma_rozmowy : varchar
  lokalizacja_lub_link : varchar
  status_rozmowy : varchar
  wynik_rozmowy : varchar
  notatki : text
}

entity "Propozycja terminu" as PropozycjaTerminu {
  * id_propozycji : int <<PK>>
  --
  id_rozmowy : int <<FK>>
  proponowana_data : date
  godzina_rozpoczecia : time
  godzina_zakonczenia : time
  strefa_czasowa : varchar
  proponujacy : varchar
  status_propozycji : varchar
}

entity "Termin" as Termin {
  * id_terminu : int <<PK>>
  --
  id_rozmowy : int <<FK>>
  data : date
  godzina_rozpoczecia : time
  godzina_zakonczenia : time
  strefa_czasowa : varchar
  lokalizacja_lub_link : varchar
  status_terminu : varchar
}

entity "Spotkanie kalendarza" as SpotkanieKalendarza {
  * id_spotkania : int <<PK>>
  --
  id_rozmowy : int <<FK>>
  id_terminu : int <<FK>>
  tytul_spotkania : varchar
  opis_spotkania : text
  przypomnienia : text
  status_spotkania : varchar
}

entity "Zaproszenie" as Zaproszenie {
  * id_zaproszenia : int <<PK>>
  --
  id_rozmowy : int <<FK>>
  id_terminu : int <<FK>>
  nadawca : varchar
  odbiorcy : text
  temat : varchar
  tresc_wiadomosci : text
  status_wysylki : varchar
}

entity "Wiadomość" as Wiadomosc {
  * id_wiadomosci : int <<PK>>
  --
  id_aplikacji : int <<FK>>
  id_zaproszenia : int <<FK>>
  nadawca : varchar
  odbiorca : varchar
  temat : varchar
  tresc : text
  data_wyslania : datetime
  kanal_komunikacji : varchar
  zalaczniki : text
  aktualny_status_wysylki : varchar
}

entity "Status wysyłki" as StatusWysylki {
  * id_statusu_wysylki : int <<PK>>
  --
  id_wiadomosci : int <<FK>>
  status : varchar
  data_zmiany_statusu : datetime
  odbiorca : varchar
}

entity "Potwierdzenie" as Potwierdzenie {
  * id_potwierdzenia : int <<PK>>
  --
  id_aplikacji : int <<FK>>
  id_rozmowy : int <<FK>>
  typ_potwierdzenia : varchar
  decyzja : varchar
  data_potwierdzenia : datetime
  osoba_potwierdzajaca : varchar
  rola_potwierdzajacego : varchar
  komentarz : text
}

Klient ||--o{ Oferta : zleca
Rekruter ||--o{ Oferta : odpowiada_za
Oferta ||--|| Kryteria : ma
Kandydat ||--o{ CV : posiada
Kandydat ||--o{ Aplikacja : sklada
Oferta ||--o{ Aplikacja : przyjmuje
CV ||--o{ Aplikacja : zalaczony_do

Aplikacja ||--o{ WynikAnalizy : oceniana_w
Oferta ||--o{ Ranking : ma
Ranking ||--|{ PozycjaRankingu : zawiera
WynikAnalizy ||--o{ PozycjaRankingu : tworzy_pozycje

Oferta ||--o{ ListaKandydatow : ma
Klient ||--o{ ListaKandydatow : otrzymuje
Rekruter ||--o{ ListaKandydatow : przygotowuje
ListaKandydatow ||--|{ KandydatNaLiscie : zawiera
Aplikacja ||--o{ KandydatNaLiscie : trafia_na_liste

KandydatNaLiscie ||--o{ DecyzjaKlienta : ma
Klient ||--o{ DecyzjaKlienta : podejmuje
KandydatNaLiscie ||--o{ OpiniaKlienta : ma
Klient ||--o{ OpiniaKlienta : wystawia

KandydatNaLiscie ||--o{ Rozmowa : prowadzi_do
Kandydat ||--o{ Rozmowa : uczestniczy_w
Klient ||--o{ Rozmowa : uczestniczy_w
Rekruter ||--o{ Rozmowa : planuje
Oferta ||--o{ Rozmowa : dotyczy

Rozmowa ||--o{ PropozycjaTerminu : ma
Rozmowa ||--o| Termin : ma_potwierdzony
Rozmowa ||--o| SpotkanieKalendarza : synchronizuje
Termin ||--o| SpotkanieKalendarza : okresla
Rozmowa ||--o{ Zaproszenie : generuje
Termin ||--o{ Zaproszenie : wskazuje
Zaproszenie ||--o{ Wiadomosc : wysylane_jako
Aplikacja ||--o{ Wiadomosc : generuje
Wiadomosc ||--o{ StatusWysylki : ma_historie
Aplikacja ||--o{ Potwierdzenie : ma
Rozmowa ||--o{ Potwierdzenie : ma
Kandydat ||--o{ Potwierdzenie : sklada
Klient ||--o{ Potwierdzenie : sklada

note bottom of Aplikacja
  Para id_kandydata + id_oferty powinna być unikalna,
  żeby obsłużyć duplikat aplikacji na tę samą ofertę.
end note

note bottom of Potwierdzenie
  Potwierdzenie dotyczy aplikacji albo rozmowy.
  Potwierdzenie składa kandydat albo klient.
  Rola jest zapisana w polu rola_potwierdzajacego.
end note

note bottom of Wiadomosc
  Wiadomość może dotyczyć potwierdzenia aplikacji
  albo zaproszenia na rozmowę.
end note

@enduml
