@startuml
left to right direction
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam linetype ortho

skinparam rectangle {
  RoundCorner 15
}

actor Kandydat
actor Rekruter

rectangle "CRM firmy HR" as CRM
rectangle "System poczty e-mail" as Mail

rectangle "1.1\nPobranie oferty" as P11 #DDEEFF
rectangle "1.2\nZapis oferty" as P12 #DDEEFF
rectangle "1.3\nPublikacja oferty" as P13 #DDEEFF
rectangle "1.4\nRejestracja aplikacji" as P14 #DDEEFF
rectangle "1.5\nPotwierdzenie zgłoszenia" as P15 #DDEEFF

database "D1\nOferty" as D1
database "D2\nAplikacje" as D2

Rekruter --> P11 : dane oferty
P11 --> CRM : zapytanie oferty
CRM --> P11 : dane CRM
P11 --> P12 : oferta robocza

P12 --> D1 : oferta
P12 --> P13 : oferta

D1 --> P13 : oferta
P13 --> D1 : status oferty
P13 --> Rekruter : potwierdzenie

Kandydat --> P14 : dane aplikacji
D1 --> P14 : oferta
P14 --> D2 : aplikacja
P14 --> Kandydat : błędy
P14 --> P15 : wiadomość

P15 --> Mail : wiadomość
Mail --> P15 : status wysyłki
P15 --> Kandydat : potwierdzenie
@enduml
